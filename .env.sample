# Google ADK / Gemini configuration
# Get an API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
# Use the Gemini Developer API (not Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Investigation engine: adk (default), langgraph, or mock (no LLM — for tests/demos)
INVESTIGATION_ENGINE=adk

# Mock engine options (INVESTIGATION_ENGINE=mock only)
# MOCK_FORCE_HITL=true
# MOCK_INVESTIGATION_DELAY_MS=0

# LLM provider for both engines: gemini, ollama, or vllm
LLM_PROVIDER=gemini

# Model the ADK / LangGraph agents use when LLM_PROVIDER=gemini
ADK_MODEL=gemini-3.1-flash-lite

# Run the three evidence specialists concurrently (ADK ParallelAgent, default)
# rather than one after another. Set false only if ADK's parallel branch
# misbehaves — the stage then degrades to sequential with no other change.
ADK_PARALLEL_EVIDENCE=true

# Ollama settings when LLM_PROVIDER=ollama (run Ollama on the host, not in compose)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ── vLLM + LMCache + Aerospike (docs/lmcache-aerospike.md) ───────────────────
# Self-hosted OpenAI-compatible endpoint. Any /v1 server works; in this project
# it is vLLM on ROCm with LMCache in front and Aerospike as LMCache's remote tier.
# VLLM_BASE_URL=http://localhost:8000/v1     (in compose: http://vllm:8000/v1)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-8B
# vLLM ignores the key; any non-empty value is fine.
VLLM_API_KEY=EMPTY

# Image for the `vllm` compose profile. Stock vLLM/LMCache images do NOT include
# the Aerospike connector — build one first (see docs/lmcache-aerospike.md).
# VLLM_IMAGE=lmcache-aerospike/vllm-openai:rocm
# HF_TOKEN=

# LMCache's Aerospike backend (read by LMCache inside the vllm container).
# The namespace MUST have nsup-period > 0 or nothing ever expires and the
# namespace fills until stop-writes trips.
LMCACHE_AEROSPIKE_HOSTS=aerospike-db:3000
LMCACHE_AEROSPIKE_NAMESPACE=lmcache
LMCACHE_AEROSPIKE_SET=kv_chunks
# LMCACHE_AEROSPIKE_USERNAME=
# LMCACHE_AEROSPIKE_PASSWORD=

# ReAct prompt block order: current (default) or stable_first.
# stable_first moves the per-iteration STATUS block to the tail so the
# append-only conversation stays cacheable. Measure before flipping:
#   python backend/benchmarks/prefix_reuse.py
PROMPT_LAYOUT=current

# Frontend login gate (optional). When both are set, every page and API
# route requires signing in with this exact username/password — there's no
# user database, just this one pair. Leave both unset to disable the login
# gate entirely (e.g. for local dev).
# AUTH_USERNAME=admin
# AUTH_PASSWORD=change-me

# Written per pair by `./load_runner.sh start` on each loadgen instance (seed = the Aerospike
# cluster, GRAPH_HOST = that pair's graph instance). Fill these in only to run run-loadgen.sh by hand.
AS_HOST=
AS_PORT=3000
AS_NAMESPACE=test
GRAPH_HOST=
GRAPH_PORT=8182

# Account pool: 0 = auto from graph summary (Account1..N). Set >0 to cap pool size.

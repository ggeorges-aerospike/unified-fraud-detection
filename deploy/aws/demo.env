# Template for the demo app's .env on AWS. fetch-secrets.sh fills the demo login from Secrets
# Manager; create-demo-app.sh fills AEROSPIKE_HOST / GRAPH_HOST_ADDRESS from the running cluster
# and fleet. No API keys: Bedrock is reached with the instance role.

# Aerospike cluster seed node (private IP) and the Graph Service the app queries.
AEROSPIKE_HOST=
AEROSPIKE_KV_PORT=3000
AEROSPIKE_NAMESPACE=test
GRAPH_HOST_ADDRESS=

# remote = externally bulk-loaded billion-scale graph (counts from the graph summary, Admin
# ingest/detection disabled); local = self-contained app-managed dataset.
DATA_SOURCE_MODE=remote

# The demo app has no public address — reach it through SSM port forwarding (see README), which
# forwards both ports to localhost for whoever is viewing the demo.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# AI agents: AWS Strands on Amazon Bedrock, credentials from the instance role.
INVESTIGATION_ENGINE=strands
AWS_REGION=us-west-2
STRANDS_SPECIALIST_MODEL=us.anthropic.claude-sonnet-5-5
STRANDS_SPECIALIST_EFFORT=medium
STRANDS_INVESTIGATOR_MODEL=us.anthropic.claude-opus-5-5
STRANDS_INVESTIGATOR_EFFORT=high
STRANDS_REPORT_MODEL=us.anthropic.claude-opus-5-5
STRANDS_REPORT_EFFORT=medium

# Decision model (tier 2). Strands Decider needs a serving endpoint on AWS (SageMaker or a GPU
# host) that is not part of this deployment yet; until it exists the mock keeps the tier running.
DECISION_MODEL=mock
DECISION_MODEL_URL=

# Query bounds — a slow/hanging graph traversal can never freeze an investigation.
GRAPH_QUERY_TIMEOUT_MS=30000
GRAPH_READ_TIMEOUT_S=45
GRAPH_WRITE_TIMEOUT_S=20
TOOL_TIMEOUT_S=90

# Frontend login gate. Leave blank in git — fetch-secrets.sh fills these from Secrets Manager.
AUTH_USERNAME=
AUTH_PASSWORD=

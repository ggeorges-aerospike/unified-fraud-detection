# Shared settings for every deploy/aws script. Override any of these in the environment,
# e.g.  FLEET_INSTANCE_TYPE=c8a.4xlarge ./load_runner.sh create 4
#
# As on GCP, the Aerospike cluster itself is created with aerolab, outside these scripts (see
# README); everything here finds it by aerolab's AEROLAB_CLUSTER_NAME tag — the AWS counterpart of
# the GCP scripts' aerolab4cluster_name label — and runs in its region, zone and VPC.

AWS_REGION="${AWS_REGION:-us-west-2}"
# Name the cluster was created with (aerolab cluster create -n ...). Same name as on GCP.
AEROSPIKE_CLUSTER_NAME="${AEROSPIKE_CLUSTER_NAME:-demo-amd}"
AS_NAMESPACE="${AS_NAMESPACE:-test}"
AS_PORT="${AS_PORT:-3000}"

# Every resource these scripts create is named and tagged with this (Project=<prefix>).
DEPLOY_PREFIX="${DEPLOY_PREFIX:-fraud-amd}"

# Private subnet (no public IPs) that lib.sh (ensure_network) adds to the cluster's VPC for the fleet and
# app; egress through a NAT gateway. Must not overlap the VPC's existing subnets (the default
# VPC's default subnets are 172.31.0.0/20, .16.0/20, .32.0/20, ...).
PRIVATE_SUBNET_CIDR="${PRIVATE_SUBNET_CIDR:-172.31.128.0/20}"

# --- Load-gen fleet: paired (graph service + load generator), as on GCP ---
FLEET_INSTANCE_TYPE="${FLEET_INSTANCE_TYPE:-c8a.8xlarge}"   # 5th-gen AMD EPYC, 32 vCPU (GCP: n2d-standard-32)
AGS_IMAGE="${AGS_IMAGE:-aerospike/aerospike-graph-service:latest}"
GRAPH_PORT="${GRAPH_PORT:-8182}"
# Demo app data: local = app-seeded dataset + Graph Service on the app host; remote = bulk-loaded graph on graph-1.
DATA_SOURCE_MODE="${DATA_SOURCE_MODE:-local}"

# --- Demo app ---
APP_INSTANCE_TYPE="${APP_INSTANCE_TYPE:-c8a.4xlarge}"         # 5th-gen AMD EPYC

# --- Billion-scale dataset generator (CSV generation is CPU + scratch-disk heavy) ---
GEN_INSTANCE_TYPE="${GEN_INSTANCE_TYPE:-c5ad.24xlarge}"       # 96 vCPU, 2 x 1.9 TB local NVMe scratch

# --- Shared ---
UBUNTU_AMI_PARAM="${UBUNTU_AMI_PARAM:-/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id}"
ROOT_VOLUME_GB="${ROOT_VOLUME_GB:-100}"
# S3 bucket for artifacts (loadgen jar, app tarball) and the bulk-load dataset. Account id is appended.
BUCKET_BASE="${BUCKET_BASE:-${DEPLOY_PREFIX}-data}"

# Secrets Manager secret names.
SECRET_FEATURE_KEY="${SECRET_FEATURE_KEY:-${DEPLOY_PREFIX}/aerospike-features-conf}"   # read by the operator for aerolab
SECRET_DEMO_AUTH="${SECRET_DEMO_AUTH:-${DEPLOY_PREFIX}/demo-auth}"                      # read by the demo app
